{{ caddy_site_domain }} {
	root * {{ caddy_site_root }}
	file_server
	encode zstd gzip

	# PDFs keep the same names, so browsers must re-check them every time
	@cv path /cv/*
	header @cv Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

}
